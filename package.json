{
  "name": "@2jumpsina/dsh-context-guard",
  "version": "0.7.5",
  "description": "长会话越跑越贵：每轮重读全部上下文，压缩前那一刻的读数平台不留。它挂 ctx 角标，45% 起静默写交接草稿，60% 才提醒，压缩那刻记一行账，不调模型。 | Long sessions get expensive as every turn re-reads the context, and the pre-compaction reading is lost. A ctx badge, a silent handover draft from 45%, one banner at 60%, a ledger row at compaction. No model calls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/handover.mjs",
    "lib/i18n.mjs",
    "lib/client.js",
    "lib/client.template.js",
    "lib/client-source.js",
    "lib/policy.mjs",
    "lib/engine.mjs",
    "scripts/build-client.mjs",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.mjs\" && node scripts/build-client.mjs --check",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-alpha.2 <0.2.0 || >=0.2.0-0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "compaction",
    "handover",
    "token"
  ],
  "license": "MIT",
  "private": false,
  "author": "dsh-context-guard contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2JumpSinA/dsh-context-guard.git"
  },
  "homepage": "https://github.com/2JumpSinA/dsh-context-guard#readme",
  "bugs": {
    "url": "https://github.com/2JumpSinA/dsh-context-guard/issues"
  }
}
